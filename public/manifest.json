{
  "manifest_version": 3,
  "name": "musync",
  "version": "0.1.0",
  "description": "Sync your music. Share the moment. Synchronized YouTube playback between multiple devices.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://*.youtube.com/*"],
  "action": {
    "default_popup": "index.html",
    "default_title": "musync"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
